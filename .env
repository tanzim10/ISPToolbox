#PYTHONPATH=${PWD}/ISPToolbox/webserver/
#----------#


# Required so Django uses local dev settings
SECRET_KEY=dev-secret-key-1234567890
DEBUG=true
PROD=false


# Path to the Django app (important for some dev tools)
#PYTHONPATH=${PWD}/ISPToolbox/webserver/

# Django settings module
DJANGO_SETTINGS_MODULE=webserver.settings

# Postgres (local)
POSTGRES_DB=django_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (local)
REDIS_URL=redis://localhost:6379/0

# Storage (local file system, no S3)
USE_S3_STORAGE=False
MEDIA_ROOT=media/
MEDIA_URL=/media/
STATIC_ROOT=static_collect/
STATIC_URL=/static/




